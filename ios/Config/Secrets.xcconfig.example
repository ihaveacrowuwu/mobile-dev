// ────────────────────────────────────────────────────────────────────────────
// Copy this file to `Secrets.xcconfig` and fill in the value:
//
//     cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// `Secrets.xcconfig` is gitignored. NEVER commit it.
//
// Get a free key at https://home.openweathermap.org/api_keys
// A newly created key can take up to ~2 hours to activate.
//
// NOTE: xcconfig files treat `//` as a comment *anywhere* on a line, so a value
// containing a double slash would be truncated. OpenWeather keys are hex, so this
// is not a problem here, but do not paste a URL into an xcconfig without escaping.
// ────────────────────────────────────────────────────────────────────────────

OPEN_WEATHER_API_KEY = your_openweather_api_key_here

// ────────────────────────────────────────────────────────────────────────────
// Only needed to run on a physical iPhone. Leave it commented out for the
// simulator and for CI, which build without a signing identity at all.
//
// Your team ID is the ten-character code in Xcode under Settings → Accounts →
// (your Apple ID) → Manage Certificates, or at the top of
// https://developer.apple.com/account. A free Apple ID has one too.
//
// It lives here rather than in project.yml for two reasons: this file is
// gitignored, so a team ID never reaches the repository; and `xcodegen generate`
// rewrites the project, so anything set in Xcode's Signing & Capabilities editor
// is lost the next time the project is regenerated. Setting it here survives.
// ────────────────────────────────────────────────────────────────────────────

// DEVELOPMENT_TEAM = ABCDE12345
