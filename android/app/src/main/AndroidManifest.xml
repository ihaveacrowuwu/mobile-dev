<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET and ACCESS_NETWORK_STATE are declared by :core:network, the module whose code
      actually requires them, and merged in from there. They are restated here because the
      app manifest is where a reviewer looks for the app's full permission surface, the
      merger unions duplicates, so this costs nothing.

      Deliberately NOT requested: location. The user picks places by name, so asking for GPS
      would be an unjustified permission, and unnecessary permissions are a usability and
      privacy failure.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SkyCastApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkyCast.Splash"
        tools:targetApi="36">

        <!-- No android:label here: it would duplicate the application label above. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SkyCast.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
