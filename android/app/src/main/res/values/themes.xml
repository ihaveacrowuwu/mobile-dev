<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists only for the window before Compose takes over: the splash
  screen and the system bar defaults. Everything after the first frame is themed in
  Kotlin by SkyCastTheme.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SkyCast" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!--
      Backed by androidx.core:core-splashscreen so the Android 12+ splash API is used
      on new devices and emulated consistently on older ones.
    -->
    <style name="Theme.SkyCast.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Theme handed to the activity once the splash screen dismisses. -->
        <item name="postSplashScreenTheme">@style/Theme.SkyCast</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

</resources>
