    <!--
      Plurals rather than plain strings: both carry a count followed by a word, and Android Lint
      correctly refuses that as a string because most languages inflect it even where English does
      not. "Percent" happens not to, so both quantities read alike, the point is that a translator
      is given the choice.
    -->
    <plurals name="detail_trend_description">
        <item quantity="one">Temperature from %1$s to %2$s over the next day</item>
        <item quantity="other">Temperature from %1$s to %2$s over the next %3$d days</item>
    </plurals>
