<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-facing string lives here. Never hardcode display text in a composable:
  it makes the app untranslatable, and it hides copy from review.
-->
<resources>
    <string name="app_name">SkyCast</string>

    <!-- ── Tabs ─────────────────────────────────────────────────────────── -->
    <string name="tab_today">Today</string>
    <string name="tab_forecast">Forecast</string>
    <string name="tab_locations">Locations</string>
    <string name="tab_settings">Settings</string>

    <!-- Longer descriptions announced by TalkBack, where the short label is ambiguous. -->
    <string name="tab_today_description">Today\'s weather</string>
    <string name="tab_forecast_description">Five day forecast</string>
    <string name="tab_locations_description">Saved locations</string>
    <string name="tab_settings_description">Settings</string>

    <!-- ── Actions ──────────────────────────────────────────────────────── -->
    <string name="action_add_location">Add location</string>
    <string name="action_back">Back</string>

    <!-- ── Today ────────────────────────────────────────────────────────── -->
    <string name="today_loading">Fetching the latest weather…</string>
    <string name="today_empty_title">No locations yet</string>
    <string name="today_empty_message">Add a place and SkyCast will keep its forecast ready, even offline.</string>
    <string name="today_feels_like">Feels like %1$d%2$s</string>
    <!--
      One combined announcement for the hero block. Without it a screen-reader user
      hears the place, the number, the unit and the description as four disconnected
      fragments.
    -->
    <string name="today_conditions_accessibility">%1$s, %2$d%3$s, %4$s, feels like %5$d%3$s</string>
    <string name="today_open_detail_action">Open full details</string>
    <string name="today_hourly_heading">Through the day</string>
    <string name="today_hourly_now">Now</string>
    <string name="today_hourly_accessibility">%1$s, %2$d%3$s</string>
    <string name="today_select_location">Choose a place</string>
    <string name="today_showing_location">Showing %1$s, %2$d of %3$d</string>

    <!-- ── Banners ──────────────────────────────────────────────────────── -->
    <string name="banner_data_may_be_out_of_date">Showing saved data, it may be out of date.</string>

    <!-- ── Errors ───────────────────────────────────────────────────────── -->
    <string name="error_offline_title">No internet connection</string>
    <string name="error_offline_message">Connect to a network and try again. Saved locations still work offline.</string>
    <string name="error_timeout_title">That took too long</string>
    <string name="error_timeout_message">The weather service did not respond in time.</string>
    <string name="error_not_found_title">Place not found</string>
    <string name="error_not_found_message">We couldn\'t find weather data for that location.</string>
    <string name="error_rate_limited_title">Too many requests</string>
    <string name="error_rate_limited_message">You\'ve hit the free API limit. Try again in a minute.</string>
    <string name="error_unauthorized_title">API key not configured</string>
    <string name="error_unauthorized_message">Add your OpenWeather key to local.properties and rebuild. See the README for setup steps.</string>
    <string name="error_server_title">Service unavailable</string>
    <string name="error_server_message">The weather service is having problems. Please try again shortly.</string>
    <string name="error_decoding_title">Unexpected response</string>
    <string name="error_decoding_message">We couldn\'t read the weather data. This is a bug, please report it.</string>
    <string name="error_storage_title">Storage problem</string>
    <string name="error_storage_message">Saved data couldn\'t be read. Clearing the cache in Settings may help.</string>
    <string name="error_unknown_title">Something went wrong</string>
    <string name="error_unknown_message">An unexpected error occurred. Please try again.</string>

    <!-- ── Settings ─────────────────────────────────────────────────────── -->
    <string name="settings_section_units">Units</string>
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_section_storage">Storage</string>
    <!--
      Unit *names* are not here: they come from DisplayUnit.displayName so that adding a unit
      cannot leave the settings screen out of step. Only the group headings are translatable.
    -->
    <string name="settings_temperature">Temperature</string>
    <string name="settings_wind_speed">Wind speed</string>
    <string name="settings_pressure">Pressure</string>
    <string name="settings_visibility">Visibility</string>
    <string name="theme_system">Follow system</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>
    <string name="settings_dynamic_colour">Use wallpaper colours</string>
    <string name="settings_dynamic_colour_summary">Match the app to your wallpaper (Android 12 and later).</string>
    <string name="settings_clear_cache">Clear cached weather</string>
    <string name="settings_clear_cache_summary">Removes saved forecasts. Your locations are kept.</string>
    <string name="settings_about">About &amp; licences</string>

    <!-- ── Detail readings ──────────────────────────────────────────────── -->
    <string name="detail_humidity">Humidity</string>
    <string name="detail_wind">Wind</string>
    <string name="detail_pressure">Pressure</string>
    <string name="detail_visibility">Visibility</string>
    <string name="detail_sunrise">Sunrise</string>
    <string name="detail_sunset">Sunset</string>

    <!-- ── Forecast ─────────────────────────────────────────────────────── -->
    <!--
      No unit symbol: TemperatureUnit.symbol is already "°C"/"°F", so appending it produced
      "25° / 17°°C". The unit is established by the hero reading on Today, and a bare degree sign
      is what every weather app shows in a forecast row. The accessibility string below still
      spells the unit out, because a screen-reader user has no hero on screen to infer it from.
    -->
    <string name="forecast_high_low">%1$d° / %2$d°</string>
    <!-- One combined TalkBack announcement per row: date, condition, high, low, rain chance. -->
    <string name="forecast_day_accessibility">%1$s, %2$s, high %3$d%4$s, low %5$d%4$s, %6$d%% chance of rain</string>

    <!-- ── Locations ────────────────────────────────────────────────────── -->
    <string name="locations_empty_title">No saved places</string>
    <string name="locations_empty_message">Search for a city to start tracking its weather.</string>
    <!-- %1$s is the place name, so TalkBack says which row the control belongs to. -->
    <string name="locations_set_primary">Show %1$s on the Today tab</string>
    <string name="locations_is_primary">%1$s is shown on the Today tab</string>
    <string name="locations_delete">Remove %1$s</string>

    <!-- ── Add location (search) ────────────────────────────────────────── -->
    <string name="add_location_field_label">City name</string>
    <string name="add_location_placeholder">e.g. London</string>
    <string name="add_location_clear">Clear search</string>
    <string name="add_location_prompt">Type at least two letters to search.</string>
    <string name="add_location_no_results">No places found for “%1$s”.</string>

    <!-- ── Detail screens ───────────────────────────────────────────────── -->
    <string name="detail_location_title">Location details</string>
    <string name="detail_day_title">Day details</string>
    <string name="detail_missing_title">Place no longer saved</string>
    <string name="detail_missing_message">It looks like this location was removed. Go back to see your list.</string>
    <!-- Latitude, longitude. Four decimal places is roughly 11 m: more precision than a city needs. -->
    <string name="detail_coordinates">%1$.4f, %2$.4f</string>
    <string name="detail_observed_at">Observed %1$s</string>

    <string name="day_detail_hourly_heading">Hour by hour</string>
    <string name="day_detail_high_low">High %1$d%3$s · Low %2$d%3$s</string>
    <string name="day_detail_wind">%1$.1f %2$s</string>
    <string name="day_detail_missing_title">Day not available</string>
    <string name="day_detail_missing_message">This day has rolled out of the five-day forecast window.</string>
    <string name="day_detail_hour_accessibility">%1$s, %2$d%3$s</string>
    <!--
      "%%" rather than the word "percent": TalkBack reads the symbol as "percent" anyway, and
      Android Lint flags "%d percent" as a plurals candidate, correctly, since English needs
      "1 percent" but this phrasing cannot express that. Matches forecast_day_accessibility.
    -->
    <string name="day_detail_rain_accessibility">%1$d%% chance of rain</string>

